# AIRI testbed — local environment template.
#
# Copy this file to `.env` (which is gitignored) and fill in API keys
# for the vendors you want to test. Each variable is optional; if a
# variable is unset, the harness simply skips that vendor.
#
# Pricing reference: a full Critical-tier run (15 vectors × 1 vendor +
# Haiku judge) typically costs $0.05–0.15 per vendor. The harness
# emits the per-row latency + token usage in the CSV output so you
# can audit your costs.

# Anthropic Claude — https://console.anthropic.com/
# Default harness model: claude-sonnet-4-5 (override with
# --anthropic-model). Judge defaults to claude-haiku-4-5-20251001.
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Default harness model: gpt-4o-2024-11-20 (override with
# --openai-model).
OPENAI_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
# Default harness model: gemini-2.5-pro (override with
# --gemini-model). Note: thinking-mode tokens consume the
# max_output_tokens budget; the harness raises it to 4096 by default.
GEMINI_API_KEY=

# Perplexity — https://www.perplexity.ai/settings/api
# Default harness model: llama-3.1-sonar-large-128k-online
# (override with --perplexity-model).
PERPLEXITY_API_KEY=

# Mistral — https://console.mistral.ai/
# Default harness model: mistral-large-latest (override with
# --mistral-model). EU-hosted by default.
MISTRAL_API_KEY=
